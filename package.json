{
  "name": "mido-downloada",
  "productName": "Mido Download",
  "version": "0.7.0",
  "description": "Open-source download manager powered by aria2",
  "main": "src/main/main.js",
  "author": "Mohammed Lotfy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "fetch-aria2": "node scripts/fetch-aria2.js",
    "dist": "electron-builder --win nsis",
    "make-icon": "electron scripts/make-icon.js",
    "fetch-media-tools": "node scripts/fetch-media-tools.js",
    "dist:ci": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.mido.downloada",
    "productName": "Mido Download",
    "files": [
      "src/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/aria2",
        "to": "aria2"
      },
      {
        "from": "resources/yt-dlp",
        "to": "yt-dlp"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mido-Download-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mohammedlotfy028-droid",
        "repo": "mido-downloada",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammedlotfy028-droid/mido-downloada.git"
  }
}
